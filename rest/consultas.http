# @apiUrl = http://localhost:8080
# @apiUrl = http://host.docker.internal:8080
@apiUrl = https://host.docker.internal:8443

###
# Autentica como profissional
# @name login
POST {{apiUrl}}/signin HTTP/1.1
Content-Type: application/x-www-form-urlencoded

username=medico@clinica.com&password=medico123

###
GET {{apiUrl}}/consultas HTTP/1.1
Authorization: Bearer {{login.response.body.$.access_token}}

### Cria uma consulta (o id é gerado pelo servidor)
# @name criarConsulta
POST {{apiUrl}}/consultas/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
    "paciente": "Maria Silva",
    "medico": "Dr. João Souza",
    "data": "2026-10-01T14:30:00",
    "observacoes": "Trazer exames anteriores"
}

### Busca a consulta criada acima
GET {{apiUrl}}/consultas/{{criarConsulta.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{login.response.body.$.access_token}}

### Atualiza a consulta criada acima
PUT {{apiUrl}}/consultas/{{criarConsulta.response.body.$.data.id}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
    "paciente": "Maria Silva",
    "medico": "Dr. João Souza",
    "data": "2026-10-02T09:00:00",
    "observacoes": "Remarcada a pedido da paciente"
}

### Remove a consulta criada acima
DELETE {{apiUrl}}/consultas/{{criarConsulta.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{login.response.body.$.access_token}}

### Consulta inexistente (espera 404)
GET {{apiUrl}}/consultas/00000000-0000-0000-0000-000000000000 HTTP/1.1
Authorization: Bearer {{login.response.body.$.access_token}}

### Campos obrigatórios faltando (espera 422)
POST {{apiUrl}}/consultas/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
    "paciente": "Maria Silva"
}

### Agenda do dia de hoje (página HTML da recepção)
GET {{apiUrl}}/agenda HTTP/1.1
Authorization: Bearer {{login.response.body.$.access_token}}

### Consulta com HTML malicioso, para testar o escape (XSS)
POST {{apiUrl}}/consultas/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
    "paciente": "<script>alert(1)</script>",
    "medico": "Dr. João Souza",
    "data": "2026-10-01T16:00:00",
    "observacoes": "<img src=x onerror=alert(2)>"
}

### Agenda de 01/10/2026: o <script> acima deve aparecer como &lt;script&gt;
GET {{apiUrl}}/agenda?data=2026-10-01 HTTP/1.1
Authorization: Bearer {{login.response.body.$.access_token}}
